; Product-neutral F6 native virtual-raster fixture.

config_version=5

[application]

config/name="Virtual Geometry Native Raster F6"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")

[display]

window/size/viewport_width=800
window/size/viewport_height=450
window/size/window_width_override=800
window/size/window_height_override=450
window/vsync/vsync_mode=0

[rendering]

renderer/rendering_method="flux"
flux/ray_tracing/diagnostics/collect_gpu_timings=true
scaling_3d/mode=0
