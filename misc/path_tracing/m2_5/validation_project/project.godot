; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Flux Runtime Validation"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=640
window/size/window_height_override=360
window/vsync/vsync_mode=0

[rendering]

flux/ray_tracing/enabled=1
flux/ray_tracing/environment_lighting/enabled=true
flux/ray_tracing/reflection_strength=0.6
flux/ray_tracing/reflection_roughness_cutoff=0.6
flux/ray_tracing/ambient_occlusion_strength=0.35
flux/ray_tracing/ambient_occlusion_distance=3.0
flux/ray_tracing/diagnostics/collect_gpu_timings=true
scaling_3d/mode=4
scaling_3d/mode.macos=4
scaling_3d/scale=0.5
