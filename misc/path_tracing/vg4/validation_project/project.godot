; Product-neutral VG4 Metal transport fixture.

config_version=5

[application]

config/name="Virtual Geometry Ray Structure Validation"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.8", "Forward Plus")

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=640
window/size/window_height_override=360
window/vsync/vsync_mode=0

[rendering]

flux/ray_tracing/enabled=1
flux/ray_tracing/diagnostics/collect_gpu_timings=true
flux/ray_tracing/environment_lighting/enabled=false
flux/ray_tracing/reflection_strength=1.0
flux/ray_tracing/reflection_roughness_cutoff=0.7
flux/ray_tracing/global_illumination/strength=1.0
scaling_3d/mode=0

